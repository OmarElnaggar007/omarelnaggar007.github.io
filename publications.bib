@article{elnaggar2023inactivity,
  title = {{An interpretable framework for sleep posture change detection and postural inactivity segmentation using wrist kinematics}},
  author = {Elnaggar, Omar and Arelhi, Roselina and Coenen, Frans and Hopkinson, Andrew and Mason, Lyndon and Paoletti, Paolo},
  type = {Journal article},
  doi = {10.1038/s41598-023-44567-9},
  url = {https://doi.org/10.1038/s41598-023-44567-9},
  publisher = {Springer Science and Business Media LLC},
  language = {en},
  journal = {{Scientific Reports}},
  volume = {13},
  number = {1},
  eid = {18027},
  issn = {2045-2322},
  abstract = {Sleep posture and movements offer insights into neurophysiological health and correlate with overall well-being and quality of life. Clinical practices utilise polysomnography for sleep assessment, which is intrusive, performed in unfamiliar environments, and requires trained personnel. While sensor technologies such as actigraphy are less invasive alternatives, concerns about their reliability and precision in clinical practice persist. Moreover, the field lacks a universally accepted algorithm, with methods ranging from raw signal thresholding to data-intensive classification models that may be unfamiliar to medical staff. This paper proposes a comprehensive framework for objectively detecting sleep posture changes and temporally segmenting postural inactivity using clinically relevant joint kinematics, measured by a custom-made wearable sensor. The framework was evaluated on wrist kinematic data from five healthy participants during simulated sleep. Intuitive three-dimensional visualisations of kinematic time series were achieved through dimension reduction-based preprocessing, providing an out-of-the-box framework explainability that may be useful for clinical monitoring and diagnosis. The proposed framework achieved up to 99.2\% F1-score and 0.96 Pearson’s correlation coefficient for posture detection and inactivity segmentation respectively. This work paves the way for reliable home-based sleep movement analysis, serving patient-centred longitudinal care.},
  online-date = {2023-10-21},
  license = {https://creativecommons.org/licenses/by/4.0/},
  keywords = {Applied mathematics, Engineering},
  related = {elnaggar2023kidspreprint},
  relatedtype = {haspreprint},
  date = {2023-10-21},
  year = {2023},
  month = {10},
  urldate = {2026-10-11},
}

@article{elnaggar2023oneshot,
  title = {{Sleep posture one-shot learning framework based on extremity joint kinematics: In-silico and in-vivo case studies}},
  author = {Elnaggar, Omar and Coenen, Frans and Hopkinson, Andrew and Mason, Lyndon and Paoletti, Paolo},
  type = {Journal article},
  doi = {10.1016/j.inffus.2023.02.003},
  url = {https://doi.org/10.1016/j.inffus.2023.02.003},
  publisher = {Elsevier BV},
  language = {en},
  journal = {{Information Fusion}},
  volume = {95},
  pages = {215--236},
  issn = {1566-2535, 1872-6305},
  print-date = {2023-07},
  license = {http://creativecommons.org/licenses/by/4.0/},
  abstract = {Sleep posture is linked to several health conditions such as nocturnal cramps and more serious musculoskeletal issues. However, in-clinic sleep assessments are often limited to vital signs (e.g. brain waves). Wearable sensors with embedded inertial measurement units have been used for sleep posture classification; nonetheless, previous works consider only few (commonly four) postures, which are inadequate for advanced clinical assessments. Moreover, posture learning algorithms typically require longitudinal data collection to function reliably, and often operate on raw inertial sensor readings unfamiliar to clinicians. This paper proposes a new framework for sleep posture classification based on a minimal set of joint angle measurements. The proposed framework is validated on a rich set of twelve postures in two experimental pipelines: computer animation to obtain synthetic postural data, and human participant pilot study using custom-made miniature wearable sensors. Through fusing raw geo-inertial sensor measurements to compute a filtered estimate of relative segment orientations across the wrist and ankle joints, the body posture was characterised in a way comprehensible to medical experts. The proposed sleep posture learning framework offers plug-and-play posture classification by capitalising on a novel kinematic data augmentation method that requires only one training example per posture. Additionally, a new metric together with data visualisations were employed to extract meaningful insights from the postures dataset, demonstrate the added value of the data augmentation method, and explain the classification performance. The proposed framework attained promising overall accuracy as high as 100\% on synthetic data and 92.7\% on real data, on par with state of the art data-hungry algorithms available in the literature.},
  keywords = {Wearable sensors, Sensor fusion, Data augmentation, One-shot learning, Multi-classifier system, Human posture},
  related = {elnaggar2022oneshotpreprint},
  relatedtype = {haspreprint},
  date = {2023-07},
  year = {2023},
  month = {7},
  urldate = {2026-10-11},
}

@inproceedings{elnaggar2020inbed,
  title = {{In-Bed Human Pose Classification Using Sparse Inertial Signals}},
  author = {Elnaggar, Omar and Coenen, Frans and Paoletti, Paolo},
  type = {Conference paper},
  doi = {10.1007/978-3-030-63799-6_25},
  url = {https://doi.org/10.1007/978-3-030-63799-6_25},
  publisher = {Springer International Publishing},
  language = {en},
  booktitle = {{Artificial Intelligence XXXVII}},
  pages = {331--344},
  isbn = {9783030637989, 9783030637996},
  issn = {0302-9743, 1611-3349},
  online-date = {2020-12-08},
  print-date = {2020},
  license = {http://www.springer.com/tdm},
  abstract = {Recent studies on sleep reveal its impact on the well-being of humans. Monitoring of in-bed body postures can provide clinicians with early indicators of a wide range of musculoskeletal disorders. Current work on sleep pose classification is directed at non-wearable technologies, with issues associated to limited body observability and concerns over personal privacy; or on wearable sensors that consider only a small number of sleep poses and thus have limited generalisation. This paper proposes a novel method for wearable-based human pose classification capable of classifying twelve benchmark sleeping poses. To overcome the scarcity of labelled inertial data, a new data augmentation technique is proposed to generate realistic synthetic datasets emulating real-world conditions. An Error-Correcting Output Codes model is used to employ a multi-class classifier based on an ensemble of Support Vector Machine based classifiers. For system validation, a computer graphics simulator was used to accurately emulate data recording of in-bed body postures, leveraging on a standard articulated body file format commonly used by commercial motion-capture technologies. Experiments show superior performance (as high as 100\% classification accuracy), and resilience to noise contamination beyond what could be encountered in reality.},
  editor = {Bramer, Max and Ellis, Richard},
  address = {Cham},
  series = {Lecture Notes in Computer Science},
  volume = {12498},
  edition = {1},
  eventtitle = {40th International Conference on Innovative Techniques and Applications of Artificial Intelligence (AI 2020)},
  venue = {Cambridge, UK},
  eventdate = {2020-12-15/2020-12-17},
  keywords = {Sleeping pose classification, Human pose classification, Wearable sensing, Data augmentation, Support Vector Machine},
  date = {2020-12-08},
  year = {2020},
  month = {12},
  urldate = {2026-10-11},
}

@inproceedings{elnaggar2019speaker,
  title = {{A New Unsupervised Short-Utterance based Speaker Identification Approach with Parametric t-SNE Dimensionality Reduction}},
  author = {Elnaggar, Omar and Arelhi, Roselina},
  type = {Conference paper},
  doi = {10.1109/icaiic.2019.8669051},
  url = {https://doi.org/10.1109/icaiic.2019.8669051},
  publisher = {IEEE},
  language = {en},
  booktitle = {{2019 International Conference on Artificial Intelligence in Information and Communication (ICAIIC)}},
  pages = {092--101},
  print-date = {2019-02},
  license = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
  eventtitle = {2019 International Conference on Artificial Intelligence in Information and Communication (ICAIIC)},
  venue = {Okinawa, Japan},
  eventdate = {2019-02-11/2019-02-13},
  isbn = {9781538678220, 9781538678237},
  issn = {2831-6983, 2831-6991},
  series = {International Conference on Artificial Intelligence in Information and Communication (ICAIIC)},
  abstract = {State-of-the-art speaker identification (SI) systems have achieved accuracies of 100\% with long-duration utterances which are impractical. Recently, short-utterance based systems have gained attention although identification rates are lower. This paper presents an approach for text-dependent speaker phoneme-based (< 1sec) SI with parametric t-distributed stochastic neighbor embedding (pt-SNE) for dimensionality reduction of features to provide 3D-visualization. The approach employs Gaussian mixture model enhanced by K-means++ and gap statistic methods. As there is no other similar work, a fair comparison is unavailable. The 75\% rate achieved is comparable to other works using (i) short-utterances (ii) pt-SNE for recognition of other data types.},
  keywords = {parametric t-distributed stochastic neighbor embedding, deep neural network, data visualization, Gaussian mixture model},
  date = {2019-02},
  year = {2019},
  month = {2},
  urldate = {2026-10-11},
}

@inproceedings{elnaggar2021knowledge,
  title = {{Quantification of Knowledge Exchange within Classrooms: An AI-based Approach}},
  author = {Elnaggar, Omar and Arelhi, Roselina},
  type = {Conference paper},
  doi = {10.22492/issn.2188-1162.2021.17},
  url = {https://doi.org/10.22492/issn.2188-1162.2021.17},
  publisher = {The International Academic Forum(IAFOR)},
  language = {en},
  booktitle = {{The European Conference on Education 2021: Official Conference Proceedings}},
  pages = {221--231},
  issn = {2188-1162},
  online-date = {2021-09-06},
  eventtitle = {The European Conference on Education 2021},
  abstract = {Knowledge management improves efficiency and productivity of a company. A typical knowledge transfer pipeline, an enabler of knowledge management, consists of academics, higher education institutions, research funding bodies and companies. While the knowledge exchange mainstream sheds light on research collaborations, the evaluation of in-classroom knowledge exchange is often omitted, underestimating the impact this would have on the student employability. Current work on knowledge exchange at higher education institutions primarily focuses on: (i) collaborations with external parties, and (ii) identifying factors that affect knowledge sharing behaviours. This paper extends knowledge exchange to classroom teaching through: (i) formulating a framework among undergraduate Engineering students, and (ii) proposing an Artificial Intelligence based approach for evaluating the knowledge exchange process. The framework comprises of two group coursework with an intermediate handover event emulating an industrial workplace scenario in which knowledge exchange plays a key role. Then, an artificial intelligence-based visualisation technique processes data from two coursework-based surveys, completed before and after the abrupt handover event, to assess the change in the student intellectual backgrounds using two-dimensional maps embedding students as datapoints. The results interestingly reveal correlations between standard student evaluation metrics (for example grades, peer review and survey scores) and the formation of datapoint clusters. It is argued in the paper that the proposed artificial intelligence tool lends educators with tools to better understand the individual student performance in ways that are not captured by conventional academic assessments.},
  series = {ECE2021},
  license = {https://papers.iafor.org/iafor-user-license/},
  keywords = {Knowledge Exchange, Knowledge Transfer, Knowledge Sharing, Dimensionality Reduction, Assessment Metrics},
  eventdate = {2021-07-15/2021-07-18},
  venue = {Online from London, United Kingdom},
  date = {2021-09-06},
  year = {2021},
  month = {9},
  urldate = {2026-10-11},
}

@phdthesis{elnaggar2025thesis,
  title = {{Intelligent Wearable Sensing for Human Sleep Posture Classification and Temporal Analyses: From Simulation to Real World}},
  author = {ElNaggar, Omar},
  type = {PhD thesis},
  doi = {10.17638/03193133},
  url = {https://livrepository.liverpool.ac.uk/id/eprint/3193133},
  language = {en},
  school = {University of Liverpool},
  department = {School of Engineering},
  pagetotal = {349},
  submissiondate = {2025-04-14},
  keywords = {Changepoint detection, Human sleep posture, Multi-classifier system, One-shot learning, Posture data augmentation, Sensor fusion, Temporal analysis, Wearable sensors},
  abstract = {Musculoskeletal conditions, such as joint pain and muscle cramps, are prevalent and arise from complex interactions between individual risk factors, lifestyle habits, and occupational demands. Despite extensive research, the aetiology of many conditions remains poorly understood. Provocative sleep postures and their duration have been identified as risk factors for various sleep-related musculoskeletal complications; however, this causal relationship is only partially uncovered in the clinical literature. Traditional methods allowed only basic sleep posture analysis, necessitating substantial advancements to meet clinical needs and address technical gaps in clinical sleep research. This research investigated two interrelated problems: the “classification” and “temporal analysis” of a broad range of complex sleep postures. In the pursuit of fulfilling these two analyses, the research addressed practical challenges in sleep posture analysis, including the scarcity of labelled data, limited generalisability of existing methods, lack of clinical interpretability, and the need for better usability for lay users. The research unfolded into three interconnected studies: in-silico and in-vivo studies on advanced sleep posture classification, and a subsequent temporal analysis study concentrated on sleep posture change detection and segmentation of postural inactivity in time. The in-silico and in-vivo studies aimed to increase the number and complexity of classifiable sleep postures whilst removing the need for extensive collection and manual labelling of sleep posture data. Both studies examined twelve sleep postures, potentially provocative to musculoskeletal health. The first two studies led to the development of the In-Silico Sleep Posture Classification (Silico-SPC) and In-Vivo Sleep Posture Classification (Vivo-SPC) frameworks, both of which were equivalent but differed in their medium of operation: simulation for Silico-SPC and the real world for Vivo-SPC. Both frameworks were machine learning-enabled and designed to be clinically meaningful and explainable. They employed the same sleep posture characterisation method based on segment-to-segment orientations across four extremity joints (wrists and ankles). Additionally, they employed the same novel method for sleep posture data augmentation, facilitating sleep posture learning from a single labelled observation. In stark contrast to previous data-hungry methods, the proposed data augmentation method was an essential contribution towards personalised and rapid sleep posture learning. The Silico-SPC framework utilised computer graphics and animation techniques to simulate sleep postures, while the Vivo-SPC framework operated on human sleep posture datasets. In the in-vivo study, five datasets were acquired from human participants, recruited in simulated sleep settings, using bespoke wearable sensor modules with built-in magneto-inertial sensors. The temporal analysis study addressed the “manual labelling” of the singular posture observations, a prerequisite for the Vivo-SPC framework. The study led to the development of the Kinematics-based (In)activity Detection and Segmentation (KIDS) framework, which combined the clinical meaningfulness of joint kinematics, i.e. only that of the left wrist, with the explainability of probabilistic inference and preprogrammed logic to demarcate the start and end timestamps of sustained sleep postures. The performance of all three frameworks was validated and analysed. It was possible to draw broader insights into the problems of sleep posture classification and temporal analysis. The Silico-SPC framework was trained on and validated against two synthetic sleep posture datasets. Robust and steady posture classification performance was achieved (up to 100\% in accuracy), hence it motivated levelling up the investigation to in-vivo settings. The Vivo-SPC framework was trained on augmented human sleep posture observations and validated against real ones. Its performance (mean F1 score up to 88.45\%) matched or exceeded previously reported methods, despite the extreme scarcity of labelled data, i.e. one observation per posture. Misclassification was roughly one posture per participant, explained by inter-posture similarity and intra-posture dissimilarity. These error sources were cited in existing literature but had not been formally quantified before. The unsupervised KIDS framework was validated on sleep posture time series data, readily available from the preceding in-vivo study. It achieved near-perfect detection of posture changes (mean F1 score of 99\%) and temporal segmentation of postural inactivity (mean correlation of 0.96). During performance analysis of the framework, it was found that there was a risk of failing to detect posture changes when the left wrist joint did not exhibit suﬀicient change in orientation. While the research presented novel and promising solutions to bottlenecks in the field of sleep posture analysis, further translational research is required before it can be integrated into clinical practice. This further research could conduct further validation in real sleep settings and involve larger cohorts of healthy and patient participants. Additionally, some aspects of the research methodology could be improved, such as enhancing sensor integration to better suit indoor sleep environments.},
  note = {PhD thesis; submitted April 2025. Repository deposit: 15 August 2025.},
  date = {2025},
  year = {2025},
  urldate = {2026-10-11},
}

