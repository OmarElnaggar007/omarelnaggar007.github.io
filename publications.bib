@article{daout2025footwear,
  title = {{Footwear Choice and Locomotor Health Throughout the Life Course: A Critical Review}},
  author = {D’Août, Kristiaan and Elnaggar, Omar and Mason, Lyndon and Rowlatt, Adam and Willems, Catherine},
  type = {Journal article},
  doi = {10.3390/healthcare13050527},
  url = {https://doi.org/10.3390/healthcare13050527},
  publisher = {MDPI AG},
  language = {en},
  journal = {{Healthcare}},
  volume = {13},
  number = {5},
  issn = {2227-9032},
  abstract = {Background/objectives: In this paper, we review and discuss epidemiological and experimental evidence on the effects of daily footwear on gait and life-long health. We consider different types of footwear, including “minimal shoes”, and their design features, comparing them to barefoot walking, with a focus on overall gait and the function of the heel pad. Methods: Narrative review. Results: We find little evidence for health benefits of most typical shoe design features (e.g., cushioning, raised heels or arch support) for normal walking in healthy individuals, and in several cases (e.g., high heels), there is evidence of detrimental health effects. Conclusions: Based on currently available evidence, we recommend minimal footwear as the default for the general population to stimulate healthy biomechanical aging, with other types of footwear used infrequently or when there is an individual or clinical need.},
  online-date = {2025-02-28},
  license = {https://creativecommons.org/licenses/by/4.0/},
  keywords = {aging, biomechanics, foot, footwear, health, heel pad, shoes},
  eid = {527},
  date = {2025-02-28},
  year = {2025},
  month = {2},
  urldate = {2026-10-11},
}

